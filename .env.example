# Copy this file to .env and fill in real values. .env is gitignored, never commit it.

# Neon Postgres connection string.
# Get it from console.neon.tech -> your project -> Connection Details.
# Format: postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional, defaults to 5000
PORT=5000

# development | production
NODE_ENV=development
