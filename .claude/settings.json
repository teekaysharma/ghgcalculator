{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/protected-paths.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node scripts/hooks/credential-scan.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/format-on-write.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
