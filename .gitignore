# Node
node_modules
dist
.env

# api/index.js is deliberately NOT gitignored, unlike dist/ above -- see
# the comment in that file. Vercel's function-to-route wiring requires the
# file to exist in the pre-build git tree; a gitignored, build-time-only
# file at this same path was never routed to, confirmed on this branch.
# vercel.json's buildCommand overwrites its real contents on every deploy.

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Claude Code worktrees -- other active git worktrees under .claude/worktrees/,
# never something this repo should track. .claude/launch.json and .claude/skills/
# stay trackable (skills content is committed intentionally).
.claude/worktrees/

# Python (scripts/exiobase/build_factors.py -- offline/local only, see
# scripts/exiobase/README.md; this is compiled-bytecode cache, never source)
__pycache__/
*.pyc
