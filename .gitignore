# Node
node_modules
dist
.env

# Vercel build artifact: esbuild --bundle output of server/vercel-entry.ts,
# see vercel.json's buildCommand -- built fresh on every Vercel deploy,
# never hand-edited or committed, same convention as dist/ above. The
# whole directory is ignored rather than the file itself since its name
# (api/[...path].js, Vercel's own catch-all Function convention) contains
# gitignore glob metacharacters.
api

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Local-only project instructions -- must never be pushed to GitHub,
# per standing instruction. Claude Code still reads it locally regardless
# of git-tracking status; this only prevents it from being committed.
CLAUDE.md
